# TLS certificates and keys (server/README.md generates cert.pem/key.pem)
*.pem
*.key
*.crt

# OS / editor
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Environment and logs
.env
.env.*
*.log

# Tooling
node_modules/
coverage/
.claude/worktrees/
.claude/settings.local.json
# The quake-c-reference skill's id-Software/Quake checkout
.claude/cache/

# Registered Quake data: must never be committed or deployed publicly.
# Any pak, in any case and folder, except the shareware one (as in
# .dockerignore; CI fails if another pak is tracked).
*.[pP][aA][kK]
!/static/pak0.pak
static/hipnotic/
static/rogue/
# 2021 rerelease data (?base=rerelease) and its add-ons; id1/ for a C-style layout
static/rerelease/
static/id1/
static/mg1/
static/mg3/
static/dopa/
static/ctf/

# Wrangler local state and secrets (tools/do_cpu_probe)
.wrangler/
.dev.vars
