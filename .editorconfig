root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Files deno fmt doesn't format keep their tabs
[*.{html,css,svg,sh,py}]
indent_style = tab

# Third-party map readmes: kept byte-for-byte (CRLF, see .gitattributes)
[static/maps/*.txt]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
